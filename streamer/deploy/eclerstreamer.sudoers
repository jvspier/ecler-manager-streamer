# Installed to /etc/sudoers.d/eclerstreamer, mode 0440.
#
# The web UI's only privilege: start, stop and restart its own stream units.
# Narrow on purpose -- the wildcard covers dashboard-stream@<channel> and
# nothing else, so a bug in the service cannot reach another unit.
eclerstreamer ALL=(root) NOPASSWD: /usr/bin/systemctl start dashboard-stream@*.service, \
                                   /usr/bin/systemctl stop dashboard-stream@*.service, \
                                   /usr/bin/systemctl restart dashboard-stream@*.service
