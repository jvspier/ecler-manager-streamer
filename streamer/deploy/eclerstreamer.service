# The web UI. It manages the dashboard-stream@ units and streams nothing
# itself, so stopping or upgrading it does not interrupt a single frame.
[Unit]
Description=Ecler streamer web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eclerstreamer
Group=eclerstreamer
WorkingDirectory=/opt/eclerstreamer
ExecStart=/usr/bin/python3 /opt/eclerstreamer/run.py \
    --config /etc/eclerstreamer/config.json \
    --host 0.0.0.0 --port 8478
Restart=on-failure
RestartSec=5s

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/eclerstreamer
Environment=PAGESOURCE_RUNTIME_DIR=/var/lib/eclerstreamer/run
Environment=PAGESOURCE_PID_DIR=/run/eclerstreamer

# Creates /run/eclerstreamer owned by this unit's user. Preserve=yes so
# stopping one channel does not pull the directory out from under the others.
RuntimeDirectory=eclerstreamer
RuntimeDirectoryPreserve=yes
EnvironmentFile=-/etc/eclerstreamer/eclerstreamer.env

# NOT NoNewPrivileges: it and sudo are mutually exclusive by definition --
# sudo works by gaining privilege, which is exactly what the flag forbids, and
# it fails with "if sudo is running in a container, you may need to adjust the
# container configuration to disable the flag", which names neither sudo nor
# systemd as the cause. The stream units keep the flag; they never call sudo.
ProtectSystem=full
ProtectHome=true
# ProtectSystem=full mounts /etc read-only, and this service writes its own
# config there every time a dashboard is edited. Carving out the one
# directory keeps the rest of /etc protected; dropping to ProtectSystem=true
# would open all of it.
ReadWritePaths=/etc/eclerstreamer

[Install]
WantedBy=multi-user.target
