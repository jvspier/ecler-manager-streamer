# One instance per channel:  systemctl enable --now dashboard-stream@5
#
# The unit supervises the real work, not a launcher: stream.py execs into
# teststream.py, which owns the browser and ffmpeg, so systemd's SIGTERM
# reaches the process that knows how to tear the display down.
[Unit]
Description=Dashboard stream on channel %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eclerstreamer
Group=eclerstreamer
WorkingDirectory=/opt/eclerstreamer
ExecStart=/usr/bin/python3 /opt/eclerstreamer/stream.py --channel %i
Restart=always
RestartSec=10
TimeoutStopSec=30

# stream.py exits 2 for anything a restart cannot fix: no such channel, no
# URL set, or the dashboard disabled. Without this the unit retries every ten
# seconds for ever, filling the journal and reporting "activating" when the
# truth is that a human has to change something. A crash -- ffmpeg dying, the
# browser going away -- exits with a different status and still restarts.
RestartPreventExitStatus=2

# Chromium and Xvfb are started with setsid, which does not leave the cgroup,
# so the whole tree is cleaned up here rather than left holding a gigabyte.
KillMode=control-group

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/eclerstreamer
# Not /tmp: it is tmpfs on Debian 13, and four browser profiles plus their
# logs would sit in RAM. NOT PrivateTmp either -- the web service shells out
# to pagesource.sh for preview screenshots and has to see the same display.
Environment=PAGESOURCE_RUNTIME_DIR=/var/lib/eclerstreamer/run
Environment=PAGESOURCE_PID_DIR=/run/eclerstreamer
Environment=ECLERSTREAMER_RUN_DIR=/run/eclerstreamer

# Creates /run/eclerstreamer owned by this unit's user. Preserve=yes so
# stopping one channel does not pull the directory out from under the others.
RuntimeDirectory=eclerstreamer
RuntimeDirectoryPreserve=yes

# Logs go to the journal, which rotates on its own. An ffmpeg progress line
# twice a second filled 73MB in four days when it went to a plain file.
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
